#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>
#include <string.h>

int main() {
    int fd;
    char data[] = "UNIX I/O calls demo";
    char buffer[100] = {0};

    struct stat st;
    DIR *d;
    struct dirent *dir;

    fd = open("sample.txt", O_CREAT | O_WRONLY | O_TRUNC, 0644);
    if (fd == -1) {
        perror("Open failed");
        return 1;
    }

    write(fd, data, strlen(data));
    close(fd);

  
    fd = open("sample.txt", O_RDONLY);
    lseek(fd, 0, SEEK_SET);
    read(fd, buffer, sizeof(buffer));

    printf("File Content: %s\n", buffer);
    close(fd);

  
    if (stat("sample.txt", &st) == 0) {
        printf("\nFile Details:\n");
        printf("File Size: %ld bytes\n", st.st_size);
        printf("Permissions: %o\n", st.st_mode & 0777);
    }

 
    d = opendir(".");
    if (d == NULL) {
        perror("opendir failed");
        return 1;
    }

    printf("\nDirectory Files:\n");
    while ((dir = readdir(d)) != NULL) {
        printf("%s\n", dir->d_name);
    }

    closedir(d);

    return 0;
}

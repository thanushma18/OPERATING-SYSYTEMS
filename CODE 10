RECEIVER

#include <windows.h>
#include <stdio.h>

int main() {
    HANDLE hMailslot;
    char buffer[128];
    DWORD bytesRead;


    hMailslot = CreateMailslot(
        "\\\\.\\mailslot\\MyQueue",
        0,
        MAILSLOT_WAIT_FOREVER,
        NULL
    );

    if (hMailslot == INVALID_HANDLE_VALUE) {
        printf("Error creating mailslot\n");
        return 1;
    }

    printf("Waiting for message...\n");

 
    if (ReadFile(hMailslot, buffer, sizeof(buffer), &bytesRead, NULL)) {
        buffer[bytesRead] = '\0';
        printf("Received Message: %s\n", buffer);
    } else {
        printf("Error reading message\n");
    }



SENDER

#include <windows.h>
#include <stdio.h>
#include <string.h>

int main() {
    HANDLE hFile;
    char message[128];
    DWORD bytesWritten;

    hFile = CreateFile(
        "\\\\.\\mailslot\\MyQueue",
        GENERIC_WRITE,
        FILE_SHARE_READ,
        NULL,
        OPEN_EXISTING,
        FILE_ATTRIBUTE_NORMAL,
        NULL
    );

    if (hFile == INVALID_HANDLE_VALUE) {
        printf("Error opening mailslot\n");
        return 1;
    }

    printf("Enter message: ");
    fgets(message, sizeof(message), stdin);

  
    WriteFile(hFile, message, strlen(message), &bytesWritten, NULL);

    printf("Message Sent Successfully!\n");

    CloseHandle(hFile);
    return 0;
}
    CloseHandle(hMailslot);
    return 0;
}

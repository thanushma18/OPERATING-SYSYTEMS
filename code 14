#include <stdio.h>
#include <string.h>

char files[20][20];
int n = 0;

int main() {
    int ch, i;
    char name[20];

    while (1) {
        printf("\n1.Create  2.Delete  3.Search  4.Display  5.Exit\n");
        scanf("%d", &ch);

        switch (ch) {
            case 1:
                printf("Enter file name: ");
                scanf("%s", files[n++]);
                break;

            case 2:
                printf("Enter file to delete: ");
                scanf("%s", name);
                for (i = 0; i < n; i++) {
                    if (strcmp(name, files[i]) == 0) {
                        for (int j = i; j < n - 1; j++)
                            strcpy(files[j], files[j + 1]);
                        n--;
                        printf("Deleted\n");
                        break;
                    }
                }
                break;

            case 3:
                printf("Enter file to search: ");
                scanf("%s", name);
                for (i = 0; i < n; i++) {
                    if (strcmp(name, files[i]) == 0) {
                        printf("Found\n");
                        break;
                    }
                }
                if (i == n) printf("Not Found\n");
                break;

            case 4:
                for (i = 0; i < n; i++)
                    printf("%s\n", files[i]);
                break;

            case 5:
                return 0;
        }
    }
}

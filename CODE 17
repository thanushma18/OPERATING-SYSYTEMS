#include <stdio.h>
int main(){
 int n,m,i,j,k,alloc[10][10],max[10][10],need[10][10],avail[10],f[10]={0},seq[10],c=0;

 printf("Processes & Resources: ");
 scanf("%d%d",&n,&m);

 printf("Allocation:\n");
 for(i=0;i<n;i++) for(j=0;j<m;j++) scanf("%d",&alloc[i][j]);

 printf("Max:\n");
 for(i=0;i<n;i++) for(j=0;j<m;j++) scanf("%d",&max[i][j]);

 printf("Available: ");
 for(j=0;j<m;j++) scanf("%d",&avail[j]);

 for(i=0;i<n;i++)
  for(j=0;j<m;j++)
   need[i][j]=max[i][j]-alloc[i][j];

 while(c<n){
  int found=0;
  for(i=0;i<n;i++){
   if(!f[i]){
    for(j=0;j<m;j++) if(need[i][j]>avail[j]) break;
    if(j==m){
     for(k=0;k<m;k++) avail[k]+=alloc[i][k];
     seq[c++]=i; f[i]=1; found=1;
    }
   }
  }
  if(!found){ printf("Not Safe"); return 0; }
 }

 printf("Safe Seq: ");
 for(i=0;i<n;i++) printf("P%d ",seq[i]);
}
